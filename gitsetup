#!/bin/sh

# Configure the current repository for GPG-signed commits and sign-off.
# Requires Git, GnuPG, awk, sed, cut, grep, and standard POSIX utilities.
#
# Generated by an LLM :^)

set -eu

die() {
    printf 'gitsetup: %s\n' "$*" >&2
    exit 1
}

command -v git >/dev/null 2>&1 || die "git is required"
command -v gpg >/dev/null 2>&1 || die "gpg is required"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
    die "run inside a Git working tree"

# GitHub identity: intentionally independent of the GPG UID. Use the
# repository's existing identity as defaults, if configured.
github_name=$(git config --local --get user.name 2>/dev/null || :)
github_email=$(git config --local --get user.email 2>/dev/null || :)

printf 'GitHub author name [%s]: ' "$github_name"
IFS= read -r answer || die "could not read author name"
[ -z "$answer" ] || github_name=$answer

printf 'GitHub author email [%s]: ' "$github_email"
IFS= read -r answer || die "could not read author email"
[ -z "$answer" ] || github_email=$answer

[ -n "$github_name" ] || die "author name is required"
[ -n "$github_email" ] || die "author email is required"


repo=$(git rev-parse --show-toplevel)
printf 'Repository: %s\n\n' "$repo"

# Respect custom hooks directories rather than installing a hook
# somewhere Git will not execute it.
if git config --get core.hooksPath >/dev/null 2>&1; then
    die "core.hooksPath is configured; install the hook there manually"
fi

hook=$(git rev-parse --git-path hooks/commit-msg)

# Permit replacement only when this script previously installed the hook.
if [ -e "$hook" ] &&
   ! grep -q '^# managed-by-gitsetup$' "$hook"; then
    die "existing commit-msg hook will not be overwritten: $hook"
fi

tmp=$(mktemp "${TMPDIR:-/tmp}/gitsetup.XXXXXX") ||
    die "cannot create temporary file"
trap 'rm -f "$tmp"' 0
trap 'exit 1' HUP INT TERM

# Enumerate primary secret-key fingerprints and their UIDs.
# Output: fingerprint|UID number|UID text
gpg --batch --with-colons --fingerprint --list-secret-keys |
awk -F: '
    $1 == "sec" {
        in_key = 1
        fingerprint = ""
        uid_number = 0
        next
    }
    $1 == "ssb" {
        in_key = 0
        next
    }
    in_key && $1 == "fpr" && fingerprint == "" {
        fingerprint = $10
        next
    }
    in_key && $1 == "uid" {
        uid_number++
        if (fingerprint != "")
            printf "%s|%d|%s\n", fingerprint, uid_number, $10
    }
' > "$tmp" || die "could not enumerate GPG keys"

[ -s "$tmp" ] || die "no secret-key user IDs found"

printf 'Available signing identities:\n\n'
awk -F'|' '{
    printf "%3d) %s\n     %s\n", NR, $1, $3
}' "$tmp"

printf '\nSelect the identity to use for BOTH signing and sign-off: '
IFS= read -r choice || die "no selection provided"

case "$choice" in
    ''|*[!0-9]*) die "selection must be a number" ;;
esac

selected=$(awk -F'|' -v n="$choice" 'NR == n { print; exit }' "$tmp")
[ -n "$selected" ] || die "invalid selection"

fingerprint=$(printf '%s\n' "$selected" | cut -d'|' -f1)
uid=$(printf '%s\n' "$selected" | cut -d'|' -f3-)

# Extract the final <email> and the name preceding it.
signoff_email=$(printf '%s\n' "$uid" |
    sed -n 's/.*<\([^<>]*\)>[[:space:]]*$/\1/p')
signoff_name=$(printf '%s\n' "$uid" |
    sed 's/[[:space:]]*<[^<>]*>[[:space:]]*$//')

[ -n "$signoff_name" ] ||
    die "UID must contain a name and email: Name <email>"
[ -n "$signoff_email" ] ||
    die "UID must contain a name and email: Name <email>"

printf '\nWill configure:\n'
printf '  Author/committer: %s <%s>\n' "$github_name" "$github_email"
printf '  Signing key:      %s\n' "$fingerprint"
printf '  Sign-off:         %s <%s>\n' "$signoff_name" "$signoff_email"
printf '\nApply to this repository? [y/N] '
IFS= read -r answer || die "no confirmation provided"

case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *) printf 'Cancelled.\n'; exit 0 ;;
esac

# Repository-local configuration only.
git config --local user.name "$github_name"
git config --local user.email "$github_email"
git config --local user.useConfigOnly true
git config --local user.signingkey "$fingerprint"
git config --local commit.gpgsign true
git config --local gpg.format openpgp

# These custom values are derived from the selected GPG UID.
git config --local signoff.name "$signoff_name"
git config --local signoff.email "$signoff_email"
git config --local signoff.key "$fingerprint"

mkdir -p "$(dirname "$hook")" ||
    die "cannot create hooks directory"

cat > "$hook" <<'HOOK'
#!/bin/sh
# managed-by-gitsetup
set -eu

name=$(git config --local --get signoff.name) ||
    { echo "commit-msg: missing signoff.name; rerun gitsetup" >&2; exit 1; }
email=$(git config --local --get signoff.email) ||
    { echo "commit-msg: missing signoff.email; rerun gitsetup" >&2; exit 1; }
expected_key=$(git config --local --get signoff.key) ||
    { echo "commit-msg: missing signoff.key; rerun gitsetup" >&2; exit 1; }
actual_key=$(git config --local --get user.signingkey) ||
    { echo "commit-msg: missing user.signingkey" >&2; exit 1; }

if [ "$actual_key" != "$expected_key" ]; then
    echo -n "commit-msg: signing key differs from sign-off identity; "
    ecoh    "rerun gitsetup" >&2
    exit 1
fi

git interpret-trailers \
    --in-place \
    --if-exists addIfDifferent \
    --trailer "Signed-off-by: $name <$email>" \
    "$1"
HOOK

chmod +x "$hook" || die "cannot make hook executable"

printf '\nRepository configured successfully.\n'
printf '  GitHub identity: %s <%s>\n' "$github_name" "$github_email"
printf '  Sign-off:        %s <%s>\n' "$signoff_name" "$signoff_email"
printf '\nUse ordinary Git commands, e.g.:\n'
printf '  git commit -m "Fix container handling"\n'
printf '  git log -1 --show-signature\n'
