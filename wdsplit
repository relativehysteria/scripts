#!/usr/bin/env python3
"""Redistribute daily work durations across a supplied block of weekdays.

The script preserves total input work minutes when the supplied days have
sufficient capacity. It keeps already-valid intervals where possible and
rebuilds other days between 06:00 and 22:00, inserting a 30-minute break after
six continuous work hours and requiring 11 hours of rest between workdays.

This is a conservative scheduler, not a complete Czech Labour Code compliance
checker. It does not assess overtime, reference periods, or rest before the
first supplied day.
"""

# Generated by an LLM :^)

from __future__ import annotations

import argparse
import re
import sys
from dataclasses import dataclass
from typing import Sequence


# CONFIGURATION

# All times and durations are represented as minutes from midnight.
MINUTES_PER_DAY = 24 * 60

# Rebuilt shifts must fit inside this daytime window.
DAY_START = 6 * 60
DAY_END = 22 * 60

# Conservative shift limits, including the break reserved for longer days.
MAX_SHIFT = 12 * 60
MAX_CONTINUOUS_WORK = 6 * 60
BREAK_MINUTES = 30
MAX_WORK_PER_DAY = MAX_SHIFT - BREAK_MINUTES

# Minimum elapsed rest between consecutive scheduled workdays.
MIN_DAILY_REST = 11 * 60

WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri")
WEEKDAY_INDEX = {name.lower(): i for i, name in enumerate(WEEKDAYS)}
WEEKDAY_INDEX.update({
    "monday": 0,
    "tuesday": 1,
    "wednesday": 2,
    "thursday": 3,
    "friday": 4,
})

# Match a clock range; parse_day validates that no other text is present.
RANGE_RE = re.compile(r"(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})")


# DATA CLASSES

@dataclass(frozen=True)
class Interval:
    """Store an interval as minute offsets from midnight."""

    start: int
    end: int

    @property
    def duration(self) -> int:
        """Return the interval length in minutes."""
        return self.end - self.start


@dataclass
class DayResult:
    """Store a day's scheduled ranges and allocation status."""

    ranges: list[tuple[int, int]]
    work_minutes: int
    preserved: bool


# TIME PARSING AND FORMATTING

def parse_clock(value: str, *, allow_24: bool = False) -> int:
    """Convert a clock value to minutes after midnight."""
    try:
        hour_text, minute_text = value.split(":", 1)
        hour, minute = int(hour_text), int(minute_text)
    except (ValueError, TypeError):
        raise ValueError(f"invalid time {value!r}; expected H:MM or HH:MM") from None

    if minute < 0 or minute > 59:
        raise ValueError(f"invalid minute in time {value!r}")

    max_hour = 24 if allow_24 else 23
    if hour < 0 or hour > max_hour or (hour == 24 and (not allow_24 or minute != 0)):
        raise ValueError(f"invalid hour in time {value!r}")

    return hour * 60 + minute


def parse_day(text: str) -> list[Interval]:
    """Parse a day's ranges; treat end times at or before starts as overnight."""
    matches = list(RANGE_RE.finditer(text))
    remainder = RANGE_RE.sub("", text)
    remainder = re.sub(r"[\s,;]+", "", remainder)
    if remainder:
        raise ValueError(
            f"could not parse {remainder!r} in {text!r}; use ranges such as "
            "'8:00-10:00 13:00-18:20'"
        )

    intervals: list[Interval] = []
    for match in matches:
        start_text, end_text = match.groups()
        start = parse_clock(start_text)
        end = parse_clock(end_text, allow_24=True)

        # Treat an end at or before the start as a next-day time.
        if end <= start:
            end += MINUTES_PER_DAY

        intervals.append(Interval(start, end))

    return intervals


def format_clock(minutes: int) -> str:
    """Format a minute offset as H:MM."""
    minutes %= MINUTES_PER_DAY
    return f"{minutes // 60}:{minutes % 60:02d}"


def format_range(start: int, end: int) -> str:
    """Format a time range."""
    return f"{format_clock(start)}-{format_clock(end)}"


def format_duration(minutes: int) -> str:
    """Format a duration in hours and minutes."""
    hours, mins = divmod(minutes, 60)
    if hours and mins:
        return f"{hours}h {mins}m"
    if hours:
        return f"{hours}h"
    return f"{mins}m"


# INPUT VALIDATION AND DAILY ALLOCATION

def original_ranges_are_legal(intervals: Sequence[Interval], total: int) -> bool:
    """Check whether the original ranges meet the script's retention rules."""
    if total == 0:
        return True
    if total > MAX_WORK_PER_DAY or not intervals:
        return False

    # Every retained interval must stay within the daytime window.
    for interval in intervals:
        if interval.end <= interval.start:
            return False
        if interval.start < DAY_START or interval.end > DAY_END:
            return False
        if interval.duration <= 0:
            return False

    ordered = sorted(intervals, key=lambda x: (x.start, x.end))
    for prev, cur in zip(ordered, ordered[1:]):
        if cur.start < prev.end:
            return False

    if ordered[-1].end - ordered[0].start > MAX_SHIFT:
        return False

    # Gaps shorter than 30 minutes do not reset continuous work time.
    continuous = 0
    previous_end: int | None = None
    for interval in ordered:
        if previous_end is None or interval.start - previous_end >= BREAK_MINUTES:
            continuous = 0
        continuous += interval.duration
        if continuous > MAX_CONTINUOUS_WORK:
            return False
        previous_end = interval.end

    return True


def redistribute(durations: Sequence[int]) -> list[int]:
    """Redistribute overflow across supplied days, preserving the total."""
    original_total = sum(durations)
    capacity = len(durations) * MAX_WORK_PER_DAY
    if original_total > capacity:
        raise ValueError(
            f"{format_duration(original_total)} cannot fit into {len(durations)} "
            f"weekday(s) under the conservative daily cap of "
            f"{format_duration(MAX_WORK_PER_DAY)} per day. Nothing was discarded."
        )

    # First cap each day; then place only the excess elsewhere.
    loads = [min(d, MAX_WORK_PER_DAY) for d in durations]
    overflow = [max(0, d - MAX_WORK_PER_DAY) for d in durations]

    for source, amount in enumerate(overflow):
        remaining = amount

        # Prefer later weekdays for spillover, then work backwards if needed.
        candidates = list(range(source + 1, len(loads))) + list(range(source - 1, -1, -1))
        for dest in candidates:
            available = MAX_WORK_PER_DAY - loads[dest]
            moved = min(available, remaining)
            loads[dest] += moved
            remaining -= moved
            if remaining == 0:
                break

        # The total-capacity check should make this branch unreachable.
        if remaining:
            raise RuntimeError("internal error: could not place all overflow hours")

    assert sum(loads) == original_total
    assert all(0 <= value <= MAX_WORK_PER_DAY for value in loads)
    return loads


# SHIFT CONSTRUCTION AND WEEKDAY SCHEDULING

def rebuild_day(
    work_minutes: int,
    preferred_start: int,
    earliest_start: int,
) -> list[tuple[int, int]]:
    """Build a daytime shift, inserting a break when work exceeds six hours."""
    if work_minutes <= 0:
        return []

    # Reserve the break before calculating how late the shift may start.
    break_time = BREAK_MINUTES if work_minutes > MAX_CONTINUOUS_WORK else 0
    elapsed = work_minutes + break_time
    latest_start = DAY_END - elapsed
    if latest_start < DAY_START:
        raise ValueError("daily hours do not fit in the 06:00-22:00 window")

    # Honor both start-time limits, then move earlier if needed to fit the day.
    start = max(DAY_START, preferred_start, earliest_start)
    start = min(start, latest_start)
    if start < earliest_start:
        raise ValueError("cannot satisfy the 11-hour daily rest requirement")

    # Short shifts need no break; longer shifts split at the six-hour limit.
    if work_minutes <= MAX_CONTINUOUS_WORK:
        return [(start, start + work_minutes)]

    first_end = start + MAX_CONTINUOUS_WORK
    second_start = first_end + BREAK_MINUTES
    second_end = second_start + (work_minutes - MAX_CONTINUOUS_WORK)

    # Guard the assumptions used to calculate the two work periods.
    assert second_end - start <= MAX_SHIFT
    assert second_end <= DAY_END
    return [(start, first_end), (second_start, second_end)]


def preferred_start(intervals: Sequence[Interval]) -> int:
    """Choose the original daytime start, or 09:00 as a fallback."""
    if intervals:
        earliest = min(intervals, key=lambda x: x.start).start
        if DAY_START <= earliest < DAY_END:
            return earliest

    return 9 * 60


def schedule(daily_inputs: Sequence[list[Interval]]) -> list[DayResult]:
    """Allocate durations and schedule the supplied weekday block."""
    durations = [
        sum(interval.duration for interval in intervals)
        for intervals in daily_inputs
    ]
    targets = redistribute(durations)
    results: list[DayResult] = []

    # Track the prior non-empty shift to enforce the minimum daily rest.
    previous_work_day: int | None = None
    previous_end: int | None = None

    for day_index, (intervals, target, original_duration) in enumerate(
        zip(daily_inputs, targets, durations)
    ):
        if target == 0:
            results.append(DayResult([], 0, original_duration == 0))
            continue

        if previous_work_day is None:
            earliest_start = DAY_START
        else:
            days_between = day_index - previous_work_day

            # Convert the previous shift end into a next-day earliest start.
            earliest_start = max(
                DAY_START,
                previous_end - (MINUTES_PER_DAY - MIN_DAILY_REST),
            )

            # A blank day adds 24 hours, so the normal daytime start is allowed.
            if days_between > 1:
                earliest_start = DAY_START

        keep_original = (
            target == original_duration
            and original_ranges_are_legal(intervals, original_duration)
        )
        if keep_original:
            # Sort before checking rest and emitting the retained ranges.
            ordered = sorted(intervals, key=lambda x: (x.start, x.end))
            candidate_start = ordered[0].start

            # Keeping the input is conditional on rest from the previous shift.
            if previous_work_day is not None:
                elapsed_rest = (
                    (day_index - previous_work_day) * MINUTES_PER_DAY
                    + candidate_start - int(previous_end)
                )
                if elapsed_rest < MIN_DAILY_REST:
                    keep_original = False

        # Preserve the user's ranges only when duration, timing, and rest all pass.
        if keep_original:
            scheduled = [(x.start, x.end) for x in ordered]
            preserved = True
        else:
            scheduled = rebuild_day(
                target,
                preferred_start(intervals),
                earliest_start,
            )
            preserved = False

        results.append(DayResult(scheduled, target, preserved))
        if scheduled:
            previous_work_day = day_index
            previous_end = scheduled[-1][1]

    # Check total work, daytime bounds, breaks, daily caps, and daily rest.
    assert sum(result.work_minutes for result in results) == sum(durations)
    previous_day: int | None = None
    previous_shift_end: int | None = None

    for day_index, result in enumerate(results):
        if not result.ranges:
            continue

        assert all(DAY_START <= start < end <= DAY_END for start, end in result.ranges)
        assert result.work_minutes <= MAX_WORK_PER_DAY

        check_intervals = [Interval(start, end) for start, end in result.ranges]
        assert original_ranges_are_legal(check_intervals, result.work_minutes)

        if previous_day is not None:
            rest = (
                (day_index - previous_day) * MINUTES_PER_DAY
                + result.ranges[0][0]
                - int(previous_shift_end)
            )
            assert rest >= MIN_DAILY_REST

        previous_day = day_index
        previous_shift_end = result.ranges[-1][1]

    return results


# COMMAND-LINE INTERFACE

def parse_weekday(value: str) -> int:
    """Return the Monday-based index for a weekday name."""
    try:
        return WEEKDAY_INDEX[value.strip().lower()]
    except KeyError:
        valid = ", ".join(WEEKDAYS)
        raise argparse.ArgumentTypeError(f"use a weekday name: {valid}") from None


def main(argv: Sequence[str] | None = None) -> int:
    """Parse input, print the schedule, and return a status code."""
    parser = argparse.ArgumentParser(
        prog="wdsplit",
        description=(
            "Reschedule worked durations across supplied weekdays while avoiding "
            "night hours and weekends. Each positional argument is one day's ranges."
        ),
        epilog=(
            "Example: wdsplit '8:00-10:00 13:00-18:20' '9:00-17:45' "
            "'9:00-18:00' '9:30-18:00' '9:00-16:00'"
        ),
    )
    parser.add_argument(
        "--start-weekday",
        type=parse_weekday,
        default=0,
        help=(
            "weekday represented by the first argument (default: Mon); "
            "arguments must not include Sat/Sun"
        ),
    )
    parser.add_argument(
        "days",
        nargs="+",
        help="up to five day arguments, each containing zero or more H:MM-H:MM ranges",
    )
    args = parser.parse_args(argv)

    if len(args.days) > 5:
        parser.error("at most five day arguments are allowed")
    if args.start_weekday + len(args.days) > 5:
        parser.error(
            "these arguments would include Saturday or Sunday; split the input at the weekend "
            "and run wdsplit separately for each weekday block"
        )

    try:
        # Measure input before redistribution so the final totals can be compared.
        parsed = [parse_day(day) for day in args.days]
        input_total = sum(sum(interval.duration for interval in day) for day in parsed)
        results = schedule(parsed)
    except (ValueError, RuntimeError) as exc:
        print(f"wdsplit: error: {exc}", file=sys.stderr)
        return 2

    for offset, result in enumerate(results):
        weekday = WEEKDAYS[args.start_weekday + offset]
        rendered = " ".join(
            format_range(start, end)
            for start, end in result.ranges
        )
        if not rendered:
            rendered = "(no work)"

        note = " [kept]" if result.preserved else " [rescheduled]"
        print(f"{weekday}: {rendered}{note}")

    print(f"Total scheduled work: {format_duration(sum(r.work_minutes for r in results))}")
    print(f"Total input work:     {format_duration(input_total)}")
    print("Breaks are excluded from worked time; scheduled break after 6h is 30 minutes.")

    if input_total > 40 * 60:
        print(
            "Warning: total exceeds 40 hours; overtime rules and the applicable "
            "reference period are not assessed by this script.",
            file=sys.stderr,
        )

    if args.start_weekday != 0:
        print(
            "Note: rest before the first supplied day cannot be verified without the prior schedule.",
            file=sys.stderr,
        )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
