#!/bin/sh

# Configure the current repository for GPG-signed commits and sign-off.
# Requires Git, GnuPG, awk, sed, cut, grep, and standard POSIX utilities.
#
# Generated by an LLM :^)

set -eu

die() {
    printf 'gitsetup: %s\n' "$*" >&2
    exit 1
}

command -v git >/dev/null 2>&1 || die "git is required"
command -v gpg >/dev/null 2>&1 || die "gpg is required"

repo=$(git rev-parse --show-toplevel 2>/dev/null) ||
    die "run inside a Git working tree"

# This script installs the hook in Git's default hooks directory.
if git config --get core.hooksPath >/dev/null 2>&1; then
    die "core.hooksPath is configured; configure that hooks directory manually"
fi

# Get primary secret-key fingerprints and their UIDs.
key_data=$(gpg --batch --with-colons --fingerprint --list-secret-keys) ||
    die "could not list GPG secret keys"

identities=$(printf '%s\n' "$key_data" | awk -F: '
    $1 == "sec" {
        primary = 1
        fingerprint = ""
        next
    }
    $1 == "ssb" {
        primary = 0
        next
    }
    primary && $1 == "fpr" && fingerprint == "" {
        fingerprint = $10
        next
    }
    primary && $1 == "uid" && fingerprint != "" {
        print fingerprint "|" $10
    }
')

[ -n "$identities" ] || die "no secret-key UIDs found"

printf 'Available GPG identities:\n\n'
printf '%s\n' "$identities" | awk -F'|' '{
    uid = $0
    sub(/^[^|]*\|/, "", uid)
    printf "%2d) %s\n    %s\n", NR, $1, uid
}'

printf '\nSelect an identity: '
IFS= read -r choice || die "no selection provided"

case "$choice" in
    ''|*[!0-9]*) die "selection must be a number" ;;
esac

selected=$(printf '%s\n' "$identities" |
    awk -F'|' -v n="$choice" 'NR == n { print; exit }')

[ -n "$selected" ] || die "invalid selection"

fingerprint=${selected%%|*}
uid=${selected#*|}

# Extract the name and email from the selected GPG UID.
email=$(printf '%s\n' "$uid" |
    sed -n 's/.*<\([^<>]*\)>[[:space:]]*$/\1/p')

name=$(printf '%s\n' "$uid" |
    sed 's/[[:space:]]*<[^<>]*>[[:space:]]*$//')

[ -n "$name" ] && [ -n "$email" ] ||
    die "GPG UID must have the format: Name <email>"

printf '\nRepository: %s\n' "$repo"
printf 'Identity:  %s <%s>\n' "$name" "$email"
printf 'GPG key:   %s\n' "$fingerprint"

printf '\nConfigure this repository? [y/N] '
IFS= read -r answer || die "could not read confirmation"

case "$answer" in
    y|Y|yes|YES|Yes) ;;
    *) printf 'Cancelled.\n'; exit 0 ;;
esac

# Git identity and signing configuration.
git config --local user.name "$name"
git config --local user.email "$email"
git config --local user.useConfigOnly true
git config --local user.signingkey "$fingerprint"
git config --local commit.gpgsign true
git config --local gpg.format openpgp

# Install the commit-msg hook.
hook=$(git rev-parse --git-path hooks/commit-msg)

# Don't overwrite a hook we don't own.
if [ -e "$hook" ] && ! grep -q '^# managed-by-gitsetup$' "$hook"; then
    die "existing commit-msg hook will not be overwritten: $hook"
fi

mkdir -p "$(dirname "$hook")"

cat > "$hook" <<'HOOK'
#!/bin/sh
# managed-by-gitsetup
set -eu

name=$(git config --local --get user.name) ||
    { echo "commit-msg: missing user.name" >&2; exit 1; }

email=$(git config --local --get user.email) ||
    { echo "commit-msg: missing user.email" >&2; exit 1; }

git interpret-trailers \
    --in-place \
    --if-exists addIfDifferent \
    --trailer "Signed-off-by: $name <$email>" \
    "$1"
HOOK

chmod +x "$hook"

printf '\nRepository configured successfully.\n'
printf '  Identity: %s <%s>\n' "$name" "$email"
printf '  GPG key:  %s\n' "$fingerprint"
